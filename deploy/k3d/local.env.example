# Copy to local.env before setup if you want to change these settings.
# HMSEC_SOURCE_DIR defaults to the repository root.
HMSEC_CPU=0
HMSEC_CLUSTER=hm-sec-local
HMSEC_HTTP_BIND=127.0.0.1
HMSEC_HTTP_PORT=8088
HMSEC_PUBLIC_HOST=127.0.0.1
HMSEC_API_PORT=6550
HMSEC_MEMORY=6g
HMSEC_TIMEOUT=1800s
HMSEC_K3D_VERSION=v5.9.0
HMSEC_K3S_IMAGE=rancher/k3s:v1.35.9-k3s1
HMSEC_KUBECTL_VERSION=v1.35.9
HMSEC_COMPOSE_VERSION=v2.39.4
